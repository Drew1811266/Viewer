{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viewer.local/protocol/viewer-review-index-v4.schema.json",
  "title": "viewer-review-index-v4",
  "description": "Active engineering contract; not yet connected to the product. Cross-reference integrity, UTF-8 byte limits and aggregate PNG budgets are enforced by codecs/repositories.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "kind",
    "projectId",
    "streams"
  ],
  "properties": {
    "legacyIndex": {
      "type": "object",
      "additionalProperties": false,
      "required": ["blake3"],
      "properties": { "blake3": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
    },
    "protocolVersion": {
      "const": "viewer.review/4"
    },
    "kind": {
      "const": "index"
    },
    "projectId": {
      "$ref": "viewer-review-state-v4.schema.json#/$defs/uuid"
    },
    "streams": {
      "type": "array",
      "minItems": 0,
      "maxItems": 10000,
      "items": {
        "$ref": "viewer-review-state-v4.schema.json#/$defs/stream"
      }
    }
  }
}
