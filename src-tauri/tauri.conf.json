{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Viewer",
  "version": "0.1.7",
  "identifier": "com.viewer.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ui dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "pnpm video:runtime:stage && pnpm --dir ui build",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "Viewer",
        "width": 1280,
        "minWidth": 500,
        "height": 800,
        "transparent": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' asset: data: viewer-image: http://viewer-image.localhost; style-src 'self' 'unsafe-inline'; base-uri 'none'; form-action 'none'; object-src 'none'; frame-src 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": [
      "../target/viewer-video-runtime/universal-apple-darwin/ViewerVideoRuntime"
    ],
    "macOS": {
      "minimumSystemVersion": "13.0"
    }
  }
}
