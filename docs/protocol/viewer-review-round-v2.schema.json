{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viewer.local/protocol/viewer-review-round-v2.schema.json",
  "title": "Viewer Completed Review Round v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocolVersion",
    "status",
    "projectId",
    "reviewStreamId",
    "reviewRoundId",
    "createdAtMs",
    "completedAtMs",
    "assets",
    "feedback",
    "outcomes",
    "artifacts"
  ],
  "dependentRequired": { "taskId": ["batchId"], "batchId": ["taskId"] },
  "properties": {
    "protocolVersion": { "const": "viewer.review/2" },
    "status": { "const": "completed" },
    "projectId": { "$ref": "#/$defs/uuid" },
    "reviewStreamId": { "$ref": "#/$defs/uuid" },
    "reviewRoundId": { "$ref": "#/$defs/uuid" },
    "taskId": { "$ref": "#/$defs/productionId" },
    "batchId": { "$ref": "#/$defs/productionId" },
    "previousCompletedRoundId": { "$ref": "#/$defs/uuid" },
    "createdAtMs": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "completedAtMs": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
    "assets": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": { "$ref": "viewer-review-draft-v2.schema.json#/$defs/asset" }
    },
    "feedback": {
      "type": "array",
      "maxItems": 10000,
      "items": { "$ref": "#/$defs/feedback" }
    },
    "outcomes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50000,
      "items": { "$ref": "#/$defs/outcome" }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 50000,
      "items": { "$ref": "#/$defs/artifact" }
    }
  },
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "productionId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "normalizedCoordinate": { "type": "number", "minimum": 0, "maximum": 1 },
    "anchor": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": { "kind": { "const": "asset" } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "x", "y", "width", "height"],
          "properties": {
            "kind": { "const": "imageRect" },
            "x": { "$ref": "#/$defs/normalizedCoordinate" },
            "y": { "$ref": "#/$defs/normalizedCoordinate" },
            "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
            "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "points"],
          "properties": {
            "kind": { "const": "imageStroke" },
            "points": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2048,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["x", "y"],
                "properties": {
                  "x": { "$ref": "#/$defs/normalizedCoordinate" },
                  "y": { "$ref": "#/$defs/normalizedCoordinate" }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "positionUs"],
          "properties": {
            "kind": { "const": "videoPoint" },
            "positionUs": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "startUs", "endUs"],
          "properties": {
            "kind": { "const": "videoRange" },
            "startUs": { "type": "integer", "minimum": 0 },
            "endUs": { "type": "integer", "minimum": 1 }
          }
        }
      ]
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["assetVersionId", "anchor"],
      "properties": {
        "assetVersionId": { "$ref": "#/$defs/uuid" },
        "anchor": { "$ref": "#/$defs/anchor" }
      }
    },
    "feedback": {
      "type": "object",
      "additionalProperties": false,
      "required": ["feedbackId", "text", "createdAtMs", "targets"],
      "properties": {
        "feedbackId": { "$ref": "#/$defs/uuid" },
        "text": { "type": "string", "minLength": 1, "maxLength": 65536 },
        "createdAtMs": { "type": "integer", "minimum": 0, "maximum": 9223372036854775807 },
        "targets": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/target" }
        }
      }
    },
    "outcome": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["assetVersionId", "kind", "feedbackIds"],
          "properties": {
            "assetVersionId": { "$ref": "#/$defs/uuid" },
            "kind": { "const": "pass" },
            "feedbackIds": { "const": [] }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["assetVersionId", "kind", "feedbackIds"],
          "properties": {
            "assetVersionId": { "$ref": "#/$defs/uuid" },
            "kind": { "const": "revise" },
            "feedbackIds": {
              "type": "array",
              "minItems": 1,
              "maxItems": 10000,
              "uniqueItems": true,
              "items": { "$ref": "#/$defs/uuid" }
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["assetVersionId", "kind", "feedbackIds", "failure"],
          "properties": {
            "assetVersionId": { "$ref": "#/$defs/uuid" },
            "kind": { "const": "unreviewable" },
            "feedbackIds": { "const": [] },
            "failure": {
              "enum": ["unsupported", "damaged", "unreadable", "permissionDenied", "missing", "decodeFailed"]
            }
          }
        }
      ]
    },
    "annotation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ordinal", "feedbackId"],
      "properties": {
        "ordinal": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "feedbackId": { "$ref": "#/$defs/uuid" }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "assetVersionId",
        "relativePath",
        "blake3",
        "mediaType",
        "width",
        "height",
        "annotations"
      ],
      "properties": {
        "assetVersionId": { "$ref": "#/$defs/uuid" },
        "relativePath": {
          "type": "string",
          "pattern": "^artifacts/(?!.*(?:^|/)\\.\\.?/)(?!/)(?!.*\\\\).+$"
        },
        "blake3": { "$ref": "#/$defs/digest" },
        "mediaType": { "const": "image/png" },
        "width": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "height": { "type": "integer", "minimum": 1, "maximum": 4294967295 },
        "annotations": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "uniqueItems": true,
          "items": { "$ref": "#/$defs/annotation" }
        }
      }
    }
  }
}
